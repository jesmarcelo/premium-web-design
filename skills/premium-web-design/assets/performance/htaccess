# Modelo de .htaccess do pacote de performance da skill premium-web-design.
# Coloque em public/.htaccess; no build, o Vite leva o arquivo para dist/.
# Funciona apenas em Apache. Em Nginx, reescreva as mesmas regras na configuração do servidor.

# ==== Endereço único e página de erro (pacote de SEO; veja references/seo.md, item 12) ====
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Troque exemplo.com.br (nas quatro linhas de regra abaixo) pelo domínio definitivo de metas-de-seo.md (com ou sem www, do jeito que o canonical usa).
  # Atrás de um proxy que termina o TLS, troque "%{HTTPS} !=on" por "%{HTTP:X-Forwarded-Proto} !=https".
  # Um redirecionamento só, direto para a forma canônica: http, outro host, /index.html e pasta sem a barra final,
  # em qualquer combinação, não passam por dois saltos. Por isso as regras do index.html e da barra final vêm
  # primeiro e já apontam para o protocolo e o host canônicos; a regra de protocolo e host só recebe o resto.
  # /pasta/index.html vira /pasta/ (o Vite gera pasta/index.html): uma URL só por página, a mesma do canonical e do
  # sitemap. O teste em THE_REQUEST olha o pedido original, para não entrar em laço com o DirectoryIndex.
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://exemplo.com.br/$1 [R=301,L]
  # /pasta (sem a barra) vira /pasta/ na mesma resposta; sem esta regra, o mod_dir acrescentaria a barra num
  # segundo redirecionamento, depois do de protocolo e host.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://exemplo.com.br/$1/ [R=301,L]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^exemplo\.com\.br$ [NC]
  RewriteRule ^ https://exemplo.com.br%{REQUEST_URI} [R=301,L]
</IfModule>
# 404 de verdade: o Vite só gera 404.html se ela for uma entrada de build.rollupOptions.input.
ErrorDocument 404 /404.html

# ==== Cache ====
# Arquivos com hash no nome (a pasta /assets/ que o Vite gera; em outra stack, troque pela pasta dos
# arquivos com hash): um ano, sem revalidação. Cada versão nova tem nome novo, então nunca esbarra no
# cache da anterior.
# Arquivos sem hash (tudo o que vem de public/, como as variantes de imagem): um dia, e depois o
# navegador confere se mudaram. Assim uma imagem trocada com o mesmo nome aparece em até 24 horas.
# HTML: conferido a cada visita, para mostrar sempre a versão atual.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(js|css|webp|avif|png|jpe?g|gif|svg|ico|woff2?|ttf|otf|mp4|webm)$#">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#(\.html|/)$#">
    Header set Cache-Control "no-cache"
  </ElseIf>
</IfModule>

# Revalidação pela data de modificação, sem ETag: ao comprimir, o Apache acrescenta -gzip ou -br ao ETag e, em muitas
# versões, deixa de reconhecê-lo quando o navegador pergunta se o arquivo mudou, e responde o arquivo inteiro em vez
# de 304. A data de modificação (Last-Modified) não tem esse problema.
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

# Declara tipos de fonte, imagem, vídeo e manifesto que alguns servidores não reconhecem sozinhos
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType image/webp .webp
  AddType image/avif .avif
  AddType video/webm .webm
  AddType application/manifest+json .webmanifest
</IfModule>

# ==== Compressão dos arquivos de texto: Brotli, se o servidor oferecer; Gzip, se não ====
# No Apache 2.4, AddOutputFilterByType depende do mod_filter; sem ele, o servidor responderia com erro 500.
<IfModule mod_filter.c>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/ld+json application/manifest+json application/xml text/xml text/plain image/svg+xml image/x-icon image/vnd.microsoft.icon font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json application/manifest+json application/xml text/xml text/plain image/svg+xml image/x-icon image/vnd.microsoft.icon font/ttf font/otf
</IfModule>
</IfModule>
